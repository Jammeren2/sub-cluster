# Caddy для узла кластера (серверы без Coolify).
# On-demand TLS: сертификат выпускается при первом запросе к домену — это нужно,
# потому что на standby-узле домен ещё не указывает сюда, а после фейловера
# (DNS переключился на этот узел) серт выпустится автоматически.
#
# ask-эндпоинт ограничивает выдачу только нашими доменами (берёт их из настроек).

{
	on_demand_tls {
		ask http://app:8080/tls-check
	}
}

# Домены замени на свои, если меняются.
admin.example.net {
	tls {
		on_demand
	}
	reverse_proxy app:8080
}

happ.example.com {
	tls {
		on_demand
	}
	reverse_proxy app:8081
}
