# ── Параметры узла кластера ── (скопируй в .env и заполни на КАЖДОМ сервере)

# Уникальный id узла (короткий, латиницей). ПОСТОЯННЫЙ для машины — не меняй
# между деплоями, иначе в кластере появится «призрак» старой записи.
NODE_ID=node2
# Человеческая метка (видна в панели).
NODE_LABEL=Питер-2
# Публичный IP этого сервера — он прописывается в DNS подписок при фейловере.
NODE_PUBLIC_IP=203.0.113.10
# Приоритет: меньше = важнее. Самый живой с наименьшим приоритетом держит DNS.
NODE_PRIORITY=2

# ── Адресация кластера через статичные admin-домены (по 443, без проброса портов) ──
# Свой admin-домен ЭТОГО узла. По нему другие узлы ходят к нему (peer-API), и через
# него же открывается панель. A-запись прописываешь вручную в reg.ru (НЕ фейловерится).
CLUSTER_URL=https://admin2.example.net
ADMIN_DOMAIN=admin2.example.net
# Общий домен подписок (фейловерный — reg.ru переключает его на активный узел).
SUB_DOMAIN=happ.example.com
# Адреса ДРУГИХ узлов — их admin-домены через запятую (для бутстрапа; дальше синк сам).
PEERS=https://admin.example.net,https://admin3.example.net

# ── Общие секреты — ОДИНАКОВЫЕ на всех узлах ──
# Подпись peer-запросов кластера (любая длинная случайная строка).
CLUSTER_SECRET=change-me-cluster-secret-long-random
# Ключ шифрования секретов в БД (пароль reg.ru и т.п.). ОДИНАКОВЫЙ на всех узлах!
SECRET_KEY=change-me-secret-key-long-random

# ── Доступ в панель ──
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Необязательно ──
# Кэш ответов upstream, сек.
CACHE_TTL=60

# ── zapret (обход DPI на узле) ──
# INSTALL_ZAPRET=1 — собрать образ с nfqws (bol-van/zapret) → страница /zapret сможет
# применять стратегии. ZAPRET_ENABLE_APPLY=1 + cap_add NET_ADMIN/NET_RAW (раскомментируй
# в docker-compose) — чтобы авто-тест реально применял обход, а не только мерил baseline.
INSTALL_ZAPRET=0
ZAPRET_ENABLE_APPLY=0
# reg.ru логин/пароль и домен подписок настраиваются в панели (/settings) и
# синхронизируются по кластеру. SECRET_KEY должен совпадать на всех узлах,
# иначе пароль reg.ru не расшифруется.
