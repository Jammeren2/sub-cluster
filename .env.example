# ── Параметры узла кластера ── (скопируй в .env и заполни на КАЖДОМ сервере)

# Уникальный id узла (короткий, латиницей). Должен отличаться у каждого узла.
NODE_ID=node1
# Человеческая метка (видна в панели).
NODE_LABEL=Москва-1
# Публичный IP этого сервера — ИМЕННО он прописывается в DNS при фейловере.
NODE_PUBLIC_IP=203.0.113.11
# Приоритет: меньше = важнее. Самый живой с наименьшим приоритетом держит DNS.
NODE_PRIORITY=1

# Адреса peer-API ДРУГИХ узлов (ip:CLUSTER_PORT через запятую) — для бутстрапа.
# Дальше список узлов синхронизируется автоматически.
PEERS=203.0.113.10:8083,203.0.113.7:8083

# ── Общие секреты — ОДИНАКОВЫЕ на всех узлах ──
# Подпись peer-запросов кластера (любая длинная случайная строка).
CLUSTER_SECRET=change-me-cluster-secret-long-random
# Ключ шифрования секретов в БД (пароль reg.ru и т.п.). ОДИНАКОВЫЙ на всех узлах!
SECRET_KEY=change-me-secret-key-long-random

# ── Доступ в панель ──
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Необязательно ──
# Кэш ответов upstream, сек.
CACHE_TTL=60
# reg.ru логин/пароль и домены настраиваются в панели (/settings) и синхронизируются
# по кластеру. SECRET_KEY должен совпадать на всех узлах, иначе пароль не расшифруется.
